; Included by the isolated worker generated by test_boneage_pdf.ahk.
RunChecks:
SetBatchLines, -1
DetectHiddenWindows, On
global TestPdfMissing := false, TestOpenResults := [], TestOpenCalls := 0
global TestLastUrl := "", TestFailures := 0
global TestBrowser := new MockBoneAgeBrowser()
Gui, New
Loop, 4 {
    Gui, Add, Edit,, % (A_Index=4) ? "ACC001" : ""
}
Gui, Show, Hide, BoneAgePdf_TEST_IPC
study := {examName: "Hand AP view(L)-Bone age", gender: "M", months: 120}

Assert(BoneAgePdfPage("M", 120)=61 && BoneAgePdfPage("F", 120)=90, "existing PDF page mapping")
TestOpenResults := [false, true]
TickStudy(study, 5)
Assert(TestOpenCalls=1, "first failed open was attempted")
TickStudy(study, 10)
Assert(TestOpenCalls=1, "failed open is throttled")
Sleep, 2100
TickStudy(study)
Assert(TestOpenCalls=2 && InStr(TestLastUrl, "#page=61"), "failed open retries the requested page")
TickStudy(study, 10)
Assert(TestOpenCalls=2, "successful open is remembered")
TickStudy({examName: ""})
TickStudy(study, 5)
Assert(TestOpenCalls=2, "transient blank exam name does not reopen PDF")
GuiControl,, Edit4,
TickStudy(study, 5)
GuiControl,, Edit4, ACC001
TickStudy(study, 5)
Assert(TestOpenCalls=2, "transient blank accession does not reopen PDF")
GuiControl,, Edit4, ACC002
TickStudy(study, 5)
Assert(TestOpenCalls=3, "new accession opens even with identical age/gender")

TickStudy({examName: "Chest X-ray"})
TestPdfMissing := true
TickStudy(study, 5)
Assert(TestOpenCalls=3, "missing PDF does not invoke browser")
TestPdfMissing := false
Sleep, 2100
TickStudy(study)
Assert(TestOpenCalls=4, "PDF becoming available is retried")

TickStudy({examName: "Chest X-ray"})
TestOpenResults := ["throw", true]
TickStudy(study, 5)
Assert(TestOpenCalls=5, "browser exception is contained")
Sleep, 2100
TickStudy(study)
Assert(TestOpenCalls=6, "browser exception is retried")

; Exercise the real Chrome.Navigate control flow, mocking only OS boundaries.
browser := new MockChrome()
Clipboard := "boneage test clipboard"
browser.results := [false, true]
Assert(browser.Navigate("file:///test.pdf#page=61", "file:///test.pdf"), "navigation verifies and retries")
Assert(browser.submissions=2 && Clipboard="boneage test clipboard", "clipboard restored after successful retry")
browser.results := [false, false]
Assert(!browser.Navigate("file:///test.pdf#page=61", "file:///test.pdf"), "unverified navigation returns failure")
Assert(Clipboard="boneage test clipboard", "clipboard restored after failure")
browser.throwOnSubmit := true
caught := false
try browser.Navigate("file:///test.pdf#page=61", "file:///test.pdf")
catch
    caught := true
Assert(caught && Clipboard="boneage test clipboard", "clipboard restored after exception")
browser.throwOnSubmit := false
browser.activateOk := false
Assert(!browser.Navigate("file:///test.pdf#page=61"), "activation failure returns failure")
browser.activateOk := true
browser.launchTest := true
Assert(!browser.OpenOrNavigate("file:///test.pdf#page=61"), "failed Run returns failure")
pathChecks := browser.pathChecks
browser.lastLaunchUrl := "file:///test.pdf#page=61", browser.lastLaunchTick := A_TickCount
Assert(!browser.OpenOrNavigate(browser.lastLaunchUrl) && browser.pathChecks=pathChecks, "pending launch prevents duplicate command")
browser.launchTest := false
browser.results := [true]
Assert(browser.OpenOrNavigate("file:///test.pdf#page=61"), "verified navigation succeeds during launch cooldown")
poller := new MockUrlPoller()
Assert(poller.WaitForUrl("file:///test.pdf#page=61", 500) && poller.reads=3, "verification waits for delayed URL")
Assert(!poller.WaitForUrl("file:///wrong.pdf", 200), "verification times out on wrong URL")

; Exercise the production PDF wrapper with Chrome URL verification unavailable.
TickStudy({examName: "Chest X-ray"})
TestBrowser := new MockChrome()
TestBrowser.results := [false, false]
TickStudy(study, 5)
TickStudy(study, 100)
Assert(TestBrowser.submissions=1 && TestBrowser.urlChecks=0, "accepted PDF navigation submits once without URL verification")
Assert(TestBrowser.launches=0, "accepted navigation does not launch another PDF tab")

TickStudy({examName: "Chest X-ray"})
TestBrowser := new MockChrome()
TestBrowser.launchTest := true, TestBrowser.fakeLaunch := true, TestBrowser.launchOk := true
TickStudy(study, 5)
TestBrowser.lastLaunchTick -= 11000
TickStudy(study, 100)
Assert(TestBrowser.launches=1 && TestBrowser.urlChecks=0, "accepted PDF launch stays completed after launch cooldown")
GuiControl,, Edit4, ACC003
TickStudy(study, 5)
Assert(TestBrowser.launches=2, "next study can open its PDF once")

TickStudy({examName: "Chest X-ray"})
TestBrowser := new MockChrome()
TestBrowser.launchTest := true, TestBrowser.fakeLaunch := true, TestBrowser.launchOk := false
TickStudy(study, 5)
Assert(TestBrowser.launches=1, "rejected launch is attempted")
TestBrowser.launchOk := true
Sleep, 2100
TickStudy(study)
TickStudy(study, 100)
Assert(TestBrowser.launches=2, "rejected launch can recover without repeating the accepted launch")

if (TestFailures) {
    FileAppend, % "FAIL: " TestFailures " bone-age PDF checks`n", *
    ExitApp, 1
}
FileAppend, PASS: bone-age PDF recovery and Chrome navigation checks (no live browser/RIS actions)`n, *
ExitApp, 0

TickStudy(study, count:=1) {
    Loop, % count {
        OpenBoneAgePdfForCurrentStudy(study)
    }
}

Assert(condition, message) {
    global TestFailures
    if (!condition) {
        TestFailures += 1
        FileAppend, % "FAIL: " message "`n", *
    }
}

class MockBoneAgeBrowser extends Chrome {
    OpenOrNavigate(url, matchPrefix:="", openNewIfMissing:=true, maxTabs:=20, verifyUrl:=true) {
        global TestOpenCalls, TestOpenResults, TestLastUrl
        TestOpenCalls += 1, TestLastUrl := url
        result := TestOpenResults.Length() ? TestOpenResults.RemoveAt(1) : true
        if (result="throw")
            throw Exception("simulated browser error")
        return result
    }
}

DebugLog(section, message) {
}

class MockChrome extends Chrome {
    activateOk := true
    submissions := 0
    pathChecks := 0
    urlChecks := 0
    launches := 0
    Activate(timeoutSec:=2, hwnd:=0) {
        return this.activateOk
    }
    WindowSpec() {
        return "BoneAgePdf_TEST_IPC ahk_class AutoHotkeyGUI"
    }
    FindTabByUrlPrefix(prefix, maxTabs:=20) {
        return true
    }
    Navigate(url, matchPrefix:="", openNewIfMissing:=true, maxTabs:=20, verifyUrl:=true) {
        if (this.launchTest)
            return false
        return base.Navigate(url, matchPrefix, openNewIfMissing, maxTabs, verifyUrl)
    }
    SubmitAddress(value, hwnd:=0) {
        this.submissions += 1
        Clipboard := value
        if (this.throwOnSubmit)
            throw Exception("simulated lost focus")
        return true
    }
    WaitForUrl(url, timeoutMs:=1500) {
        this.urlChecks += 1
        return this.results.Length() ? this.results.RemoveAt(1) : false
    }
    LaunchUrl(url) {
        this.launches += 1
        if (this.fakeLaunch)
            return this.launchOk
        return base.LaunchUrl(url)
    }
    FindBrowserPath() {
        this.pathChecks += 1
        return A_ScriptFullPath "\missing_chrome.exe"
    }
}

class MockUrlPoller extends Chrome {
    reads := 0
    ActiveUrl() {
        this.reads += 1
        return (this.reads>=3) ? "file:///test.pdf#page=61" : ""
    }
}
