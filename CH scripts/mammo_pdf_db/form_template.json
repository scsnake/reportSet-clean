  "report_phrases": {
    "_doc": "Positive findings to surface in the SCREENING INFO line of the radiology report. Keys are <field>.<value>. Order here = output order. Omit a key entirely to keep that positive private (education, breastfed, exam_in_two_years, etc. are intentionally excluded). 'detail_placeholder' wraps in (...) — when the structured DB value is unavailable (most are needs_visual handwritten), it is inserted as a literal placeholder for the radiologist to overwrite. 'skip_if' suppresses redundant clauses (e.g. L/R when bilateral Y is already emitted).",

    "family_hx_breast_cancer.yes":             { "phrase": "family history",               "detail_placeholder": "relation" },
    "disease_history.breast_cancer":           { "phrase": "history of breast cancer" },
    "disease_history.breast_benign_lesion":    { "phrase": "history of benign breast lesion" },
    "disease_history.breast_has_past_disease": { "phrase": "past breast disease",           "detail_placeholder": "specify" },
    "disease_history.other_cancer":            { "phrase": "history of other cancer",      "detail_placeholder": "site" },
    "hrt_usage.true":                          { "phrase": "HRT (+)" },
    "oral_contraceptive_usage.true":           { "phrase": "OCP (+)" },
    "palpable_mass.true":                      { "phrase": "palpable mass",                 "detail_placeholder": "side/location" },
    "breast_op_history.Y":                     { "phrase": "prior breast operation",       "detail_placeholder": "side, year" },
    "breast_op_history.L":                     { "phrase": "L breast operation",           "skip_if": "breast_op_history.Y" },
    "breast_op_history.R":                     { "phrase": "R breast operation",           "skip_if": "breast_op_history.Y" },
    "menopause_reason.hysterectomy":           { "phrase": "post-hysterectomy" },
    "menopause_reason.oophorectomy":           { "phrase": "post-oophorectomy" }
  },

