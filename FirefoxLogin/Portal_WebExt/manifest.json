{
  "applications": {
    "gecko": {
      "id": "scsnake@gmail.com", 
			"strict_min_version": "57.0",
			"update_url": "https://example.com/update.json"
    }
  },
  "manifest_version": 2,
  "name": "N hospital Portal Scripts",
  "version": "3.15",
  "description": "Helpful scripts for N hospital portal websites\n\nIf automatic updating failed, please download from the homepage link shown below ↓↓",
  "author": "scsnake@gmail.com",
	"homepage_url": "https://example.com/downloads/",
	
	"icons": {
		"48": "icon/ic_assignment_ind_black_48px.svg"
	},
	
	"browser_action": {
    "default_icon": "icon/ic_assignment_ind_black_48px.svg",
    "default_title": "Auto-Login",
    "default_popup": "popup/PortalLogin.html"
  },
	
	"permissions": [
		"*://*.hospital-n.local/*",
		"*://testenv/*",
		"*://portal/*",
		"tabs",
		"activeTab",
		"webRequest",
		"webRequestBlocking",
		"nativeMessaging",
		"bookmarks", 
		"idle"
	],
	
	"background": {
		"scripts": ["popup/md5.js", "jquery.js", "browser-polyfill.js", "update_bookmarks.js", "background-script.js"]
	},
	
	"content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self'", 
  
